<Window x:Class="AionDPS.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc Settings.WindowTitle}" Height="640" Width="780" MinHeight="520" MinWidth="700"
        Background="Transparent" WindowStartupLocation="CenterOwner" Foreground="{DynamicResource Brush.Body}"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="{DynamicResource FontSize.Base}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    <!-- The settings in the overlay's "modern classic" look (Stacy, 2026-10-16, after QuestLog): the
         same charcoal and slate as the overlay and the details window, a sidebar of seven pages (Familiers since 2026-10-17) with
         the open one in purple, the settings in rounded cards - one line each, its name on the left
         and its control on the right - and switches for the on/off ones. Only the dress changed:
         every x:Name the code-behind reads is the same control as before. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The sidebar's icons, 16x16, drawn as lines. -->
        <Geometry x:Key="IconCapture">M2,3 H14 V11 H2 Z M5.5,14 H10.5 M8,11 V14</Geometry>
        <Geometry x:Key="IconOverlay">M2,2.5 H14 V13.5 H2 Z M4.5,5.5 H11.5 M4.5,8 H9.5 M4.5,10.5 H7.5</Geometry>
        <Geometry x:Key="IconSound">M2,6 H4.5 L8.5,3 V13 L4.5,10 H2 Z M11,5.5 Q12.8,8 11,10.5 M12.8,3.5 Q15.8,8 12.8,12.5</Geometry>
        <Geometry x:Key="IconFights">M8,2 A6,6 0 1 1 7.99,2 M8,4.8 V8 L10.4,9.6</Geometry>
        <Geometry x:Key="IconKeys">M1.5,4 H14.5 V12 H1.5 Z M4,6.6 H5 M7.5,6.6 H8.5 M11,6.6 H12 M4.5,9.4 H11.5</Geometry>
        <Geometry x:Key="IconPets">M2.2,7 A1.3,1.4 0 1 1 4.8,7 A1.3,1.4 0 1 1 2.2,7 M4.9,3.8 A1.3,1.5 0 1 1 7.5,3.8 A1.3,1.5 0 1 1 4.9,3.8 M8.5,3.8 A1.3,1.5 0 1 1 11.1,3.8 A1.3,1.5 0 1 1 8.5,3.8 M11.2,7 A1.3,1.4 0 1 1 13.8,7 A1.3,1.4 0 1 1 11.2,7 M8,8.6 C5.6,8.6 4.1,11.6 5,13 C6,14.2 7,13.4 8,13.4 C9,13.4 10,14.2 11,13 C11.9,11.6 10.4,8.6 8,8.6 Z</Geometry>
        <Geometry x:Key="IconUpdates">M13.2,8.5 A5.2,5.2 0 1 1 11.6,4.3 M12,1.5 V4.6 H8.9</Geometry>

        <!-- A sidebar entry: icon and name; the open page lit in purple with a bar on its left. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNav"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.NavText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}" Stroke="{DynamicResource Brush.Dim}" StrokeThickness="1.4" Width="16" Height="16"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,11,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Mark" Width="3" CornerRadius="1.5" Background="{DynamicResource Brush.Brand}"
                                    HorizontalAlignment="Left" Margin="0,9" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BrandNav}"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.BrandLight}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page heads, section names, cards and their lines. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs.20}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
        <Style x:Key="PageHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,0,0,16"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs.11.5}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Dim}"/>
            <Setter Property="Margin" Value="4,2,0,7"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Frame}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Divider}"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs.11.5}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <!-- A status line under a button: gone while it has nothing to say. -->
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource RowHint}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Percent" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- On/off: a switch on the right of its line, purple when on. The whole line is the
             CheckBox, so a click anywhere on it flips the switch. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="22" CornerRadius="11" Margin="16,0,0,0"
                                        Background="{DynamicResource Brush.Frame}" BorderBrush="{DynamicResource Brush.Thumb}" BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource Brush.BodySoft}" HorizontalAlignment="Left" Margin="2,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Brand}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.BrandEdge}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.FrameStrong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fields: dark, rounded, the frame purple while typing. -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Brand}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A shortcut: a key cap, the combination centred in it. -->
        <Style x:Key="KeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Lists. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BrandSelect}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Frame}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="1" CornerRadius="6">
                                            <Path Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" ClipToBounds="True"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" Placement="Bottom" VerticalOffset="4">
                                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="1"
                                        CornerRadius="6" Padding="4" MaxHeight="320"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sliders: a thin rail, purple up to a round white knob. -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" Background="{DynamicResource Brush.Brand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderFill}" Background="{DynamicResource Brush.Frame}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFFFFF" Stroke="{DynamicResource Brush.Brand}" StrokeThickness="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Brush.BrandLight}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons: rounded; a light veil on hover whatever their colour. Primary is Save. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Button}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <Border x:Name="Veil" Background="Transparent" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Veil" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Veil" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Brand}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandEdge}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrand}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeClose" TargetType="Button" BasedOn="{StaticResource Chrome}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0,10,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin dark scroll bar, the thumb only (as in the details window). -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Brush.Thumb}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Frame}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>

    <!-- AllowsTransparency hands the whole window to this Border, rounded corners included (no OS
         sliver at the top edge, see git history). -->
    <Border CornerRadius="10" BorderBrush="{DynamicResource Brush.WindowEdge}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource Color.SurfaceTop}" Offset="0"/>
                <GradientStop Color="{DynamicResource Color.SurfaceBottom}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The sidebar, a shade darker, from top to bottom. -->
            <Border Grid.RowSpan="2" Background="#38000000" CornerRadius="10,0,0,10" BorderBrush="{DynamicResource Brush.SideLine}" BorderThickness="0,0,1,0"/>

            <!-- Title bar: app icon and title over the sidebar, minimize and close on the right. "✕"
                 is Cancel: close without saving. -->
            <Grid Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="AppIconImage" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Brush.Muted}"
                               FontSize="{DynamicResource Fs.12}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Chrome}" Click="OnMinimizeClicked">
                        <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource ChromeClose}" Click="OnCancelClicked">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The seven pages. -->
            <DockPanel Grid.Row="1" Margin="10,8,10,12">
                <TextBlock x:Name="SidebarVersionText" DockPanel.Dock="Bottom" Foreground="{DynamicResource Brush.Faint}" FontSize="{DynamicResource Fs.11}" Margin="12,0,0,0"/>
                <StackPanel>
                    <RadioButton x:Name="NavInstall" Style="{StaticResource NavItem}" Tag="{StaticResource IconCapture}" IsChecked="True" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.AionInstallation}"/>
                    <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Tag="{StaticResource IconOverlay}" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.Nav.Overlay}"/>
                    <RadioButton x:Name="NavPets" Style="{StaticResource NavItem}" Tag="{StaticResource IconPets}" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.Nav.Pets}"/>
                    <RadioButton x:Name="NavBanner" Style="{StaticResource NavItem}" Tag="{StaticResource IconSound}" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.Nav.Banner}"/>
                    <RadioButton x:Name="NavFights" Style="{StaticResource NavItem}" Tag="{StaticResource IconFights}" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.Nav.Fights}"/>
                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" Tag="{StaticResource IconKeys}" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.Hotkeys}"/>
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Tag="{StaticResource IconUpdates}" Checked="OnNavChecked"
                                 Content="{local:Loc Settings.Updates}"/>
                </StackPanel>
            </DockPanel>

            <!-- Right: the open page over Cancel / Save. -->
            <DockPanel Grid.Row="1" Grid.Column="1">
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.SideLine}" BorderThickness="0,1,0,0" Padding="20,12,26,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{local:Loc Settings.Cancel}" Click="OnCancelClicked" Margin="0,0,10,0"/>
                        <Button Content="{local:Loc Settings.Save}" Click="OnSaveClicked" Style="{StaticResource Primary}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="26,10,22,4">
                    <Grid>
                        <!-- Capture: what the meter listens to, and who you are. -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavInstall, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.AionInstallation}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{local:Loc Settings.Aion2Hint}" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{local:Loc Settings.Aion2Character}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{local:Loc Settings.Aion2Character.Hint}" Style="{StaticResource RowHint}"/>
                                            </StackPanel>
                                            <TextBox x:Name="Aion2CharacterNameBox" Grid.Column="1" Width="230"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Settings.CaptureAdapter}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{local:Loc Settings.CaptureAdapter.Hint}" Style="{StaticResource RowHint}"/>
                                            <ComboBox x:Name="CaptureAdapterBox" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="AutoUploadProfileBox">
                                        <TextBlock Text="{local:Loc Settings.AutoUploadProfile}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Overlay: its look, the window, what it shows. -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavOverlay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.Nav.Overlay}" Style="{StaticResource PageTitle}" Margin="2,0,0,14"/>
                            <TextBlock Text="{local:Loc Settings.Section.Look}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <!-- The "modern classic" look and three variants of it (Ui/Themes, ThemeManager);
                                         the overlay, this window, the spells and the history follow it on Save. -->
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="210">
                                                <ComboBoxItem Content="{local:Loc Settings.ThemeDark}" Tag="Dark"/>
                                                <ComboBoxItem Content="{local:Loc Settings.ThemeMidnight}" Tag="Midnight"/>
                                                <ComboBoxItem Content="{local:Loc Settings.ThemeElyos}" Tag="Elyos"/>
                                                <ComboBoxItem Content="{local:Loc Settings.ThemeAsmodian}" Tag="Asmodian"/>
                                            </ComboBox>
                                            <TextBlock Text="{local:Loc Settings.Theme}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <ComboBox x:Name="FontSizeBox" DockPanel.Dock="Right" Width="210">
                                                <ComboBoxItem Content="{local:Loc Settings.SizeSmall}" Tag="Small"/>
                                                <ComboBoxItem Content="{local:Loc Settings.SizeMedium}" Tag="Medium"/>
                                                <ComboBoxItem Content="{local:Loc Settings.SizeLarge}" Tag="Large"/>
                                            </ComboBox>
                                            <TextBlock Text="{local:Loc Settings.FontSize}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <!-- Items from LocalizationManager.SupportedLanguages (code-behind); a
                                         choice repaints every open window at once (OnLanguageChanged). -->
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="210" SelectionChanged="OnLanguageChanged"/>
                                            <TextBlock Text="{local:Loc Settings.Language}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="210">
                                                <Slider x:Name="OverlayOpacitySlider" Width="166" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Value, ElementName=OverlayOpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource Percent}"/>
                                            </StackPanel>
                                            <TextBlock Text="{local:Loc Settings.OverlayOpacity}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{local:Loc Settings.Section.Window}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <!-- Same value as the View menu's "Always on top" (MeterSettings.AlwaysOnTopOnStartup). -->
                                    <CheckBox x:Name="AlwaysOnTopBox">
                                        <TextBlock Text="{local:Loc Settings.AlwaysOnTop}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <!-- Not deferred to Save: writes the HKCU Run key at once (OnStartWithWindowsChanged). -->
                                    <CheckBox x:Name="StartWithWindowsBox" Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged">
                                        <TextBlock Text="{local:Loc Settings.StartWithWindows}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{local:Loc Settings.Section.OnOverlay}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="ShowShareBarsBox">
                                        <TextBlock Text="{local:Loc Settings.ShowShareBars}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ShowBossHpBox">
                                        <TextBlock Text="{local:Loc Settings.ShowBossHp}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ShowRiftTimerBox">
                                        <TextBlock Text="{local:Loc Settings.ShowRiftTimer}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ShowShugoTimerBox">
                                        <TextBlock Text="{local:Loc Settings.ShowShugoTimer}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ShugoReminderBox">
                                        <TextBlock Text="{local:Loc Settings.ShugoReminder}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ShowFieldBossTimerBox">
                                        <TextBlock Text="{local:Loc Settings.ShowFieldBossTimer}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="FieldBossReminderBox">
                                        <TextBlock Text="{local:Loc Settings.FieldBossReminder}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <!-- Kept for its saved value; not offered any more. -->
                                    <CheckBox x:Name="CompactOverlayBox" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Familiers (Stacy, 2026-10-17): the big live map of the needed pets (PetMapView, dragged and
                             zoomed), the zone it follows and the pets checked on it (the pins, shared with the Pets
                             window and the list over the game: PetChoices, saved at once), then the panels' settings.
                             Built in the code-behind (SettingsWindow.Pets.cs). Beside the map when there is room, below
                             it at the window's minimum size. -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavPets, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.Nav.Pets}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{local:Loc Settings.Pets.Hint}" Style="{StaticResource PageHint}"/>
                            <Grid x:Name="PetsLayout" Margin="0,0,0,16" SizeChanged="OnPetsLayoutSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="PetsSideColumn" Width="270"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0" Padding="8">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                                            <TextBlock x:Name="PetsZoomText" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11.5}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PetsMapTitle" Foreground="{DynamicResource Brush.Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{local:Loc Settings.Pets.MapHint}" Style="{StaticResource RowHint}" Margin="4,6,4,0"/>
                                        <Border x:Name="PetsMapHost" Height="440">
                                            <TextBlock x:Name="PetsNotConnected" Text="{local:Loc Pets.NotConnected}" Style="{StaticResource RowHint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24,0"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                                <StackPanel x:Name="PetsSide" Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{local:Loc Settings.Pets.Zones}" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="6">
                                        <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="PetsZonesList"/>
                                        </ScrollViewer>
                                    </Border>
                                    <DockPanel>
                                        <TextBlock x:Name="PetsAllLink" DockPanel.Dock="Right" Text="{local:Loc PetPanels.All}" ToolTip="{local:Loc PetPanels.AllTip}"
                                                   Foreground="{DynamicResource Brush.BrandLight}" FontWeight="SemiBold" FontSize="{DynamicResource Fs.11.5}" TextDecorations="Underline"
                                                   Cursor="Hand" Margin="0,2,6,7" Visibility="Collapsed" MouseLeftButtonUp="OnPetsAllClicked"/>
                                        <TextBlock Text="{local:Loc Settings.Pets.List}" Style="{StaticResource SectionLabel}"/>
                                    </DockPanel>
                                    <!-- Search over the check list (pet, monster or zone name; case and accents ignored). -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="8,0,4,0" Height="30">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0"
                                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PetsSearchHint" Grid.Column="1" Text="{local:Loc Pets.Search}" Foreground="{DynamicResource Brush.Muted}"
                                                       FontSize="{DynamicResource Fs.11.5}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                                            <TextBox x:Name="PetsSearchBox" Grid.Column="1" FontSize="{DynamicResource Fs.11.5}" Foreground="{DynamicResource Brush.Heading}"
                                                     CaretBrush="{DynamicResource Brush.Heading}" VerticalAlignment="Center" TextChanged="OnPetsSearchChanged">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                            <TextBlock x:Name="PetsSearchClear" Grid.Column="2" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="10" Padding="7,4" Cursor="Hand" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                                                       Visibility="Collapsed" MouseLeftButtonUp="OnPetsSearchClear"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0" Padding="6">
                                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="PetsCheckList"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- The panels over the game (Ui/PetPanels): the map on its own (the player's arrow, the Hidden Cubes),
                                 the pets' dots on it, the pet list (Stacy, 2026-10-17); then locked (clicks go to the game),
                                 see-through, map size, for whichever is on (UpdatePanelRows). -->
                            <TextBlock Text="{local:Loc Settings.Pets.Panels}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="MapPanelBox" Click="OnPanelBoxClicked">
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Settings.Panels.Map}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{local:Loc Settings.Panels.Map.Hint}" Style="{StaticResource RowHint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="MapPetDotsBox" IsEnabled="{Binding IsChecked, ElementName=MapPanelBox}">
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Settings.Panels.MapPets}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{local:Loc Settings.Panels.MapPets.Hint}" Style="{StaticResource RowHint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="PetListPanelBox" Click="OnPanelBoxClicked">
                                        <TextBlock Text="{local:Loc Settings.Panels.List}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="PetPanelsLockedBox">
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Settings.PetPanelsLocked}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{local:Loc Settings.PetPanelsLocked.Hint}" Style="{StaticResource RowHint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border x:Name="PetPanelsOpacityRow" Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="210">
                                                <Slider x:Name="PetPanelsOpacitySlider" Width="166" Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Value, ElementName=PetPanelsOpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource Percent}"/>
                                            </StackPanel>
                                            <TextBlock Text="{local:Loc Settings.PetPanelsOpacity}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=MapPanelBox}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="210">
                                                <Slider x:Name="PetMapSizeSlider" Width="166" Minimum="160" Maximum="600" SmallChange="10" LargeChange="20"
                                                        TickFrequency="10" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Value, ElementName=PetMapSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource Percent}"/>
                                            </StackPanel>
                                            <TextBlock Text="{local:Loc Settings.PetMapSize}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- The banner at a boss's death (Combat/LowDpsTease, Ui/TeaseBanner) and its sounds:
                             one switch for it, one for its sound, one volume (Stacy, 2026-10-11 and 15). -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavBanner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.Nav.Banner}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{local:Loc Settings.Tease.Tooltip}" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="TeaseLowDpsBox">
                                        <TextBlock Text="{local:Loc Settings.Tease}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="TeaseSoundBox" IsEnabled="{Binding IsChecked, ElementName=TeaseLowDpsBox}">
                                        <TextBlock Text="{local:Loc Settings.Tease.Sound}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <!-- "Test" plays the next MVP sound at the slider's volume, as the meter would. -->
                                    <Border Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=TeaseSoundBox}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Slider x:Name="SoundVolumeSlider" Width="166" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Value, ElementName=SoundVolumeSlider, StringFormat={}{0:P0}}" Style="{StaticResource Percent}"/>
                                                <Button x:Name="SoundTestButton" Content="{local:Loc Settings.Tease.Test}" Margin="14,0,0,0" Click="OnSoundTestClicked"/>
                                            </StackPanel>
                                            <TextBlock Text="{local:Loc Settings.Tease.Volume}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="PetFlashBox">
                                        <TextBlock Text="{local:Loc Settings.PetFlash}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Hidden Cubes (Stacy, 2026-10-17): a beep like a parking sensor while the game announces one nearby,
                                 its distance in the overlay's footer (Aion2/Aion2HiddenCubes, Ui/CubeSound). -->
                            <TextBlock Text="{local:Loc Settings.Cube.Section}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="CubeSoundBox">
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Settings.Cube.Sound}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{local:Loc Settings.Cube.Hint}" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=CubeSoundBox}">
                                        <DockPanel>
                                            <ComboBox x:Name="CubeSoundKindBox" DockPanel.Dock="Right" Width="166"/>
                                            <TextBlock Text="{local:Loc Settings.Cube.Choice}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=CubeSoundBox}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Slider x:Name="CubeVolumeSlider" Width="166" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Value, ElementName=CubeVolumeSlider, StringFormat={}{0:P0}}" Style="{StaticResource Percent}"/>
                                                <Button x:Name="CubeTestButton" Content="{local:Loc Settings.Tease.Test}" Margin="14,0,0,0" Click="OnCubeTestClicked"/>
                                            </StackPanel>
                                            <TextBlock Text="{local:Loc Settings.Tease.Volume}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="CubeDistanceBox">
                                        <TextBlock Text="{local:Loc Settings.Cube.Distance}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Fights: when a new one starts, what the rows add, what is kept. -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavFights, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.Nav.Fights}" Style="{StaticResource PageTitle}" Margin="2,0,0,14"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox x:Name="AutoResetBox" DockPanel.Dock="Right" Padding="0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{local:Loc Settings.AutoReset}" Style="{StaticResource RowTitle}"/>
                                                    <TextBox x:Name="AutoResetSecondsBox" Width="52" Height="28" Margin="8,0" TextAlignment="Center" MaxLength="3"
                                                             IsEnabled="{Binding IsChecked, ElementName=AutoResetBox}" PreviewTextInput="OnDigitsOnly"/>
                                                    <TextBlock Text="{local:Loc Settings.AutoReset.Seconds}" Style="{StaticResource RowTitle}"/>
                                                </WrapPanel>
                                                <TextBlock Text="{local:Loc Settings.AutoReset.Tooltip}" Style="{StaticResource RowHint}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ShowDamageTakenBox">
                                        <TextBlock Text="{local:Loc Settings.ShowDamageTaken}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <!-- Local only (History/FightStore, %AppData%). -->
                                    <CheckBox x:Name="RecordFightHistoryBox">
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Settings.RecordFightHistory}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{local:Loc Settings.RecordFightHistory.Hint}" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Global shortcuts: click a box, press the combination (with Ctrl, Alt, Shift or
                             Win); Backspace puts the default back. See OnHotkeyBoxKeyDown. -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavHotkeys, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.Hotkeys}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{local:Loc Settings.Hotkeys.Hint}" Style="{StaticResource PageHint}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <TextBox x:Name="HotkeyOverlayBox" DockPanel.Dock="Right" Tag="Overlay" Style="{StaticResource KeyBox}" PreviewKeyDown="OnHotkeyBoxKeyDown"/>
                                            <TextBlock Text="{local:Loc Settings.Hotkey.Overlay}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <TextBox x:Name="HotkeyResetBox" DockPanel.Dock="Right" Tag="Reset" Style="{StaticResource KeyBox}" PreviewKeyDown="OnHotkeyBoxKeyDown"/>
                                            <TextBlock Text="{local:Loc Settings.Hotkey.Reset}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <TextBox x:Name="HotkeyModeBox" DockPanel.Dock="Right" Tag="Mode" Style="{StaticResource KeyBox}" PreviewKeyDown="OnHotkeyBoxKeyDown"/>
                                            <TextBlock Text="{local:Loc Settings.Hotkey.Mode}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <TextBox x:Name="HotkeyPauseBox" DockPanel.Dock="Right" Tag="Pause" Style="{StaticResource KeyBox}" PreviewKeyDown="OnHotkeyBoxKeyDown"/>
                                            <TextBlock Text="{local:Loc Settings.Hotkey.Pause}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <TextBox x:Name="HotkeyOpenSettingsBox" DockPanel.Dock="Right" Tag="OpenSettings" Style="{StaticResource KeyBox}" PreviewKeyDown="OnHotkeyBoxKeyDown"/>
                                            <TextBlock Text="{local:Loc Settings.Hotkey.OpenSettings}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <TextBox x:Name="HotkeyToggleMapBox" DockPanel.Dock="Right" Tag="ToggleMap" Style="{StaticResource KeyBox}" PreviewKeyDown="OnHotkeyBoxKeyDown"/>
                                            <TextBlock Text="{local:Loc Settings.Hotkey.ToggleMap}" Style="{StaticResource RowTitle}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- A registered key is taken from the game (RegisterHotKey), bare F keys included. -->
                            <TextBlock Text="{local:Loc Settings.Hotkeys.GameKeys}" Style="{StaticResource PageHint}" Margin="2,12,0,0"/>
                        </StackPanel>

                        <!-- Updates - the meter's only outbound call, so it has a real switch
                             (MeterSettings.CheckForUpdates) - and the diagnostic capture. -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavUpdates, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Loc Settings.Updates}" Style="{StaticResource PageTitle}" Margin="2,0,0,14"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <!-- On demand too: in overlay mode the full window's "update ready" line
                                         is out of sight. See OnCheckUpdateClicked. -->
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="{local:Loc Settings.Update.Check}"
                                                    Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="16,0,0,0" Click="OnCheckUpdateClicked"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CurrentVersionText" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="UpdateStatusLine" Style="{StaticResource StatusLine}"/>
                                                <TextBlock x:Name="UpdateStagedLine" Style="{StaticResource StatusLine}" Visibility="Collapsed" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="CheckForUpdatesBox">
                                        <TextBlock Text="{local:Loc Settings.CheckForUpdates}" Style="{StaticResource RowTitle}"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- A capture to send when the meter shows something odd
                                 (MainWindow.ToggleDiagnosticRecording). Stays on this PC until sent. -->
                            <TextBlock Text="{local:Loc Settings.Diagnostic}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <Border Style="{StaticResource Row}">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc Settings.Diagnostic.Hint}" Style="{StaticResource RowHint}" Margin="0"/>
                                        <Button x:Name="DiagnosticButton" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnDiagnosticClicked"/>
                                        <TextBlock x:Name="DiagnosticStatusLine" Style="{StaticResource StatusLine}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
