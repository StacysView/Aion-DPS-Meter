<Window x:Class="AionDPS.Ui.PlayerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc Details.Title}" Height="580" Width="780" MinHeight="420" MinWidth="620"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Foreground="#EAF0F5" WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular"
        FontSize="{DynamicResource FontSize.Base}">
    <!-- A player's details, in the overlay's "modern classic" look (Stacy, 2026-10-16, after
         QuestLog's details panel): a header, four number tiles, two tabs - Skills and Hits. Charcoal
         with a touch of blue, slate frames, the active tab underlined in purple. -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#141C24" Offset="0"/>
            <GradientStop Color="#0B1016" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1A2430"/>
        <SolidColorBrush x:Key="FrameBrush" Color="#2A3846"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA3B3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7B5CF0"/>
        <!-- The title strip's minimize / close (ThemedChrome): flat, a light veil on hover - not
             the system's light-blue button. -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FrameBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <!-- Tabs: plain words, the active one white and underlined in purple. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="14,6,14,7" Margin="0,0,4,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The tables: no grid lines, quiet headers, soft rows. -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAF0F5"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#0CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4,8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource FrameBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{local:Loc Details.SortTooltip}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Numbers' headers stand right, over their numbers. -->
        <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <!-- A thin dark scroll bar, the thumb only. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A4A5A" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <!-- A skill: its icon and name over a bar in the player's class colour, as long as its share
             of the player's best skill. -->
        <DataTemplate x:Key="SkillCell">
            <Grid Margin="-6,2,0,2">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding BarPercent, Mode=OneWay}" Foreground="{Binding Bar}" Background="Transparent"
                             BorderThickness="0" Height="26">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Skill}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlainSkillCell">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Skill}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="18,14,18,12">
        <!-- Header: class icon, name, a ME badge for the local player; rank and class under it. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" Margin="0,0,12,0">
                <Image x:Name="ClassIcon" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderText" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border x:Name="MeBadge" Visibility="Collapsed" Background="#337B5CF0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="6,0" Margin="8,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{local:Loc Details.Me}" FontSize="10" FontWeight="Bold" Foreground="#CDBEFF"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Four tiles: DPS, damage, contribution to the group, the fight's duration. -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-10,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="RateTileLabel" Text="DPS" Style="{StaticResource TileLabel}"/>
                    <TextBlock x:Name="RateTileText" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="AmountTileLabel" Text="{local:Loc Details.Tile.Damage}" Style="{StaticResource TileLabel}"/>
                    <TextBlock x:Name="AmountTileText" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{local:Loc Details.Tile.Contribution}" Style="{StaticResource TileLabel}"/>
                    <TextBlock x:Name="ShareTileText" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{local:Loc Details.Tile.Duration}" Style="{StaticResource TileLabel}"/>
                    <TextBlock x:Name="DurationTileText" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock x:Name="NoteText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="11" FontStyle="Italic"
                   TextWrapping="Wrap" Margin="2,8,0,0"/>

        <TabControl x:Name="Tabs" Margin="0,10,0,0">
            <TabItem Header="{local:Loc Details.Tab.Skills}">
                <DataGrid x:Name="SkillsGrid" Sorting="OnGridSorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{local:Loc Details.Col.Skill}" Width="*" SortMemberPath="Skill" CellTemplate="{StaticResource SkillCell}"/>
                        <DataGridTextColumn x:Name="AmountColumn" Header="{local:Loc Details.Col.Damage}" Binding="{Binding TotalText}" SortMemberPath="Total" Width="90" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="%" Binding="{Binding ShareText}" SortMemberPath="SharePercent" Width="64" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Quiet}"/>
                        <DataGridTextColumn x:Name="RateColumn" Header="DPS" Binding="{Binding RateText}" SortMemberPath="Rate" Width="80" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{local:Loc Details.Col.Crit}" Binding="{Binding CritText}" SortMemberPath="CritRate" Width="66" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Quiet}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{local:Loc Details.Tab.Hits}">
                <DataGrid x:Name="HitsGrid" Sorting="OnGridSorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{local:Loc Details.Col.Skill}" Width="*" SortMemberPath="Skill" CellTemplate="{StaticResource PlainSkillCell}"/>
                        <DataGridTextColumn Header="{local:Loc Details.Col.Hits}" Binding="{Binding Hits, StringFormat=N0}" SortMemberPath="Hits" Width="70" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{local:Loc Details.Col.Crits}" Binding="{Binding CritHits, StringFormat=N0}" SortMemberPath="CritHits" Width="80" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=N0}" SortMemberPath="Min" Width="80" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Quiet}"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=N0}" SortMemberPath="Max" Width="80" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{local:Loc Details.Col.Average}" Binding="{Binding Average, StringFormat=N0}" SortMemberPath="Average" Width="90" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Number}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
