<Window x:Class="AionDPS.Ui.DummyLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc DummyLab.Title}" Height="620" Width="940" MinHeight="420" MinWidth="760"
        Foreground="{DynamicResource Brush.Body}" WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular"
        FontSize="{DynamicResource FontSize.Base}">
    <!-- Two fights of the local player side by side (Combat/DummyLab): what each skill did, the level
         it had, and what moved. Same dark surface as the fight history it opens from. -->
    <Window.Resources>
        <!-- The title strip's minimize / close (ThemedChrome): flat, a light veil on hover. -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs.11}"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource Color.SurfaceTop}" Offset="0"/>
                <GradientStop Color="{DynamicResource Color.SurfaceBottom}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <DockPanel Margin="24,16,20,14">
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="{DynamicResource Fs.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LineA" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"/>
                <TextBlock x:Name="LineB" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0"/>
                <TextBlock x:Name="TotalText" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" Margin="0,8,0,0"/>
                <TextBlock x:Name="VerdictText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.BrandText}" Margin="0,8,0,0"/>
                <ItemsControl x:Name="WarningsList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource Fs.11.5}" Margin="0,1,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Which skills changed level, by what their DPS did. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <TextBlock Text="{local:Loc DummyLab.Ranking}" FontSize="{DynamicResource Fs.11}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}"/>
                <ItemsControl x:Name="RankingList" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Body}" Margin="0,1,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Column heads, on the same grid as the lines under them. -->
            <Border DockPanel.Dock="Top" Margin="0,14,0,4" Padding="6,0,14,6" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{local:Loc DummyLab.ColSkill}" Style="{StaticResource Head}" TextAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{local:Loc DummyLab.ColLevel}" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="2" Text="{local:Loc DummyLab.ColPerCast}" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="3" Text="{local:Loc DummyLab.ColCrit}" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="4" Text="{local:Loc DummyLab.ColTotal}" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="5" Text="{local:Loc DummyLab.ColDps}" Style="{StaticResource Head}"/>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="30" Padding="6,0,6,0" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}" Style="{StaticResource Number}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PerCast}" Style="{StaticResource Number}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Crit}" Style="{StaticResource Number}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Total}" Style="{StaticResource Number}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding DpsChange}" Style="{StaticResource Number}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
