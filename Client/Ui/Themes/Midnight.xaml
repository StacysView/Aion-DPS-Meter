<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Midnight theme - generated palette, one Color.* and matching Brush.* per token.
         Consumed via {DynamicResource Brush.X} across Ui/*.xaml; swapped at runtime by
         Ui/ThemeManager.cs. Keep every theme defining the same token set (SelfCheck enforces it). -->
    <Color x:Key="Color.Window">#0F1220</Color>
    <Color x:Key="Color.TitleBar">#0A0C18</Color>
    <Color x:Key="Color.Panel">#161A2E</Color>
    <Color x:Key="Color.RowAlt">#131728</Color>
    <Color x:Key="Color.Control">#1C2138</Color>
    <Color x:Key="Color.ControlRaised">#222846</Color>
    <Color x:Key="Color.ControlHover">#283052</Color>
    <Color x:Key="Color.ControlHoverStrong">#303A62</Color>
    <Color x:Key="Color.Border">#2C3352</Color>
    <Color x:Key="Color.ScrollThumb">#3A4370</Color>
    <Color x:Key="Color.CheckBorder">#4A5486</Color>
    <Color x:Key="Color.CheckBorderHover">#6A76B0</Color>
    <Color x:Key="Color.TextDisabled">#5C6488</Color>
    <Color x:Key="Color.TextMuted">#8F98C2</Color>
    <Color x:Key="Color.TextSubtle">#B8BFE0</Color>
    <Color x:Key="Color.Text">#E8ECFF</Color>
    <Color x:Key="Color.Accent">#6FB1FF</Color>
    <Color x:Key="Color.RowEnemy">#4A1F34</Color>
    <Color x:Key="Color.OverlayBg">#A6000820</Color>
    <Color x:Key="Color.OverlayEnemy">#A64A1F34</Color>
    <Color x:Key="Color.OverlayText">#FFFFFF</Color>
    <Color x:Key="Color.Warning">#F0B71C</Color>
    <Color x:Key="Color.WarningSoft">#F0A848</Color>
    <Color x:Key="Color.Danger">#FF5C6A</Color>
    <Color x:Key="Color.DangerSoft">#F0A0B0</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="{StaticResource Color.TitleBar}"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="{StaticResource Color.RowAlt}"/>
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}"/>
    <SolidColorBrush x:Key="Brush.ControlRaised" Color="{StaticResource Color.ControlRaised}"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="{StaticResource Color.ControlHover}"/>
    <SolidColorBrush x:Key="Brush.ControlHoverStrong" Color="{StaticResource Color.ControlHoverStrong}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}"/>
    <SolidColorBrush x:Key="Brush.CheckBorder" Color="{StaticResource Color.CheckBorder}"/>
    <SolidColorBrush x:Key="Brush.CheckBorderHover" Color="{StaticResource Color.CheckBorderHover}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.RowEnemy" Color="{StaticResource Color.RowEnemy}"/>
    <SolidColorBrush x:Key="Brush.OverlayBg" Color="{StaticResource Color.OverlayBg}"/>
    <SolidColorBrush x:Key="Brush.OverlayEnemy" Color="{StaticResource Color.OverlayEnemy}"/>
    <SolidColorBrush x:Key="Brush.OverlayText" Color="{StaticResource Color.OverlayText}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}"/>
    <!-- The "modern classic" look (overlay, Settings, spells, history - 2026-10-15/16), per theme
         (2026-10-17): Dark keeps its exact colours, the others are its variants. -->
    <Color x:Key="Color.SurfaceTop">#111A2E</Color>
    <Color x:Key="Color.SurfaceBottom">#070B16</Color>
    <Color x:Key="Color.Card">#16213A</Color>
    <Color x:Key="Color.Frame">#24324F</Color>
    <Color x:Key="Color.FrameHover">#34466B</Color>
    <Color x:Key="Color.FrameStrong">#4A5F88</Color>
    <Color x:Key="Color.Field">#0B1222</Color>
    <Color x:Key="Color.Divider">#1C2843</Color>
    <Color x:Key="Color.WindowEdge">#34466B</Color>
    <Color x:Key="Color.Button">#18233D</Color>
    <Color x:Key="Color.ButtonEdge">#2C3D60</Color>
    <Color x:Key="Color.Thumb">#34466B</Color>
    <Color x:Key="Color.SideLine">#1A2540</Color>
    <Color x:Key="Color.Heading">#FFFFFF</Color>
    <Color x:Key="Color.Body">#E6EDFA</Color>
    <Color x:Key="Color.BodySoft">#C3CFE6</Color>
    <Color x:Key="Color.Label">#AEBBD6</Color>
    <Color x:Key="Color.Muted">#8796B5</Color>
    <Color x:Key="Color.Dim">#7584A6</Color>
    <Color x:Key="Color.Faint">#56658A</Color>
    <Color x:Key="Color.NavText">#98A7C6</Color>
    <Color x:Key="Color.Brand">#3D7BF2</Color>
    <Color x:Key="Color.BrandEdge">#5A90F5</Color>
    <Color x:Key="Color.BrandLight">#7FA9FF</Color>
    <Color x:Key="Color.BrandText">#C2D6FF</Color>
    <Color x:Key="Color.BrandSelect">#333D7BF2</Color>
    <Color x:Key="Color.BrandNav">#2A3D7BF2</Color>
    <Color x:Key="Color.OnBrand">#FFFFFF</Color>
    <Color x:Key="Color.OverlayFrame">#CC4A5F88</Color>
    <Color x:Key="Color.ModeSwitch">#1E2A47</Color>
    <SolidColorBrush x:Key="Brush.SurfaceTop" Color="{StaticResource Color.SurfaceTop}"/>
    <SolidColorBrush x:Key="Brush.SurfaceBottom" Color="{StaticResource Color.SurfaceBottom}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.Frame" Color="{StaticResource Color.Frame}"/>
    <SolidColorBrush x:Key="Brush.FrameHover" Color="{StaticResource Color.FrameHover}"/>
    <SolidColorBrush x:Key="Brush.FrameStrong" Color="{StaticResource Color.FrameStrong}"/>
    <SolidColorBrush x:Key="Brush.Field" Color="{StaticResource Color.Field}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}"/>
    <SolidColorBrush x:Key="Brush.WindowEdge" Color="{StaticResource Color.WindowEdge}"/>
    <SolidColorBrush x:Key="Brush.Button" Color="{StaticResource Color.Button}"/>
    <SolidColorBrush x:Key="Brush.ButtonEdge" Color="{StaticResource Color.ButtonEdge}"/>
    <SolidColorBrush x:Key="Brush.Thumb" Color="{StaticResource Color.Thumb}"/>
    <SolidColorBrush x:Key="Brush.SideLine" Color="{StaticResource Color.SideLine}"/>
    <SolidColorBrush x:Key="Brush.Heading" Color="{StaticResource Color.Heading}"/>
    <SolidColorBrush x:Key="Brush.Body" Color="{StaticResource Color.Body}"/>
    <SolidColorBrush x:Key="Brush.BodySoft" Color="{StaticResource Color.BodySoft}"/>
    <SolidColorBrush x:Key="Brush.Label" Color="{StaticResource Color.Label}"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Dim" Color="{StaticResource Color.Dim}"/>
    <SolidColorBrush x:Key="Brush.Faint" Color="{StaticResource Color.Faint}"/>
    <SolidColorBrush x:Key="Brush.NavText" Color="{StaticResource Color.NavText}"/>
    <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}"/>
    <SolidColorBrush x:Key="Brush.BrandEdge" Color="{StaticResource Color.BrandEdge}"/>
    <SolidColorBrush x:Key="Brush.BrandLight" Color="{StaticResource Color.BrandLight}"/>
    <SolidColorBrush x:Key="Brush.BrandText" Color="{StaticResource Color.BrandText}"/>
    <SolidColorBrush x:Key="Brush.BrandSelect" Color="{StaticResource Color.BrandSelect}"/>
    <SolidColorBrush x:Key="Brush.BrandNav" Color="{StaticResource Color.BrandNav}"/>
    <SolidColorBrush x:Key="Brush.OnBrand" Color="{StaticResource Color.OnBrand}"/>
    <SolidColorBrush x:Key="Brush.OverlayFrame" Color="{StaticResource Color.OverlayFrame}"/>
    <SolidColorBrush x:Key="Brush.ModeSwitch" Color="{StaticResource Color.ModeSwitch}"/>
</ResourceDictionary>
