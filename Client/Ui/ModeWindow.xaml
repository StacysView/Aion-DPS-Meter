<Window x:Class="AionDPS.Ui.ModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Width="300" Height="160" MinWidth="220" MinHeight="80" ShowActivated="False"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular">
    <!-- A small window of its own for one meter mode (Soins, Degats recus): the overlay's look and rows, its own list. Optional (Settings > Overlay), follows the overlay's tab
         (Tous / Groupe / Raid / PvP). Drag the header to move it, the corner to resize it. -->
    <Window.Resources>
        <local:ClassIconConverter x:Key="ClassIconConverter"/>
        <ControlTemplate x:Key="ClassBar" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" Opacity="0.45" CornerRadius="3"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Border CornerRadius="9" BorderThickness="1" Padding="6,5" BorderBrush="{DynamicResource Brush.OverlayFrame}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#D9141C24" Offset="0"/>
                <GradientStop Color="#D90B1016" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock DockPanel.Dock="Right" Text="&#x2715;" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="{DynamicResource Fs.12}" Cursor="Hand"
                           Margin="8,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="OnCloseClicked" ToolTip="{local:Loc Main.Side.Close}"/>
                <TextBlock x:Name="RateText" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Accent}" FontSize="{DynamicResource Fs.11}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="Bold" FontSize="{DynamicResource Fs.12}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="20" Margin="0,1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnRowClicked">
                            <ProgressBar Template="{StaticResource ClassBar}" Minimum="0" Maximum="100"
                                         local:SmoothBar.Target="{Binding ShareOfTop, Mode=OneWay}" Background="#12FFFFFF">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="{Binding ClassGradient}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.OverlayEnemy}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                       Height="14" Width="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding NameDisplay}" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="Bold"
                                           FontSize="{DynamicResource Fs.11}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding DpsCompact}" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="Bold"
                                           FontSize="{DynamicResource Fs.11}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding ShareDisplay}" Foreground="{DynamicResource Brush.TextSubtle}"
                                           FontSize="{DynamicResource Fs.10}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding DamageCompact}" Foreground="{DynamicResource Brush.TextSubtle}"
                                           FontSize="{DynamicResource Fs.10}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
