<Window x:Class="AionDPS.Ui.DummyTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc DummyTest.Title}" Height="720" Width="1080" MinHeight="560" MinWidth="960"
        Foreground="{DynamicResource Brush.Body}" WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular"
        FontSize="{DynamicResource FontSize.Base}">
    <!-- The timed dummy test (Ui/DummyTestController does the work, Ui/DummyTestText the wording): four pages in the
         fight history's look. Setup: length, name, the checklist and Start. Runs: the stored runs, A and B ticked on them.
         Results: the comparison and the ranking of the skills. Export: the Discord table and the CSV. -->
    <Window.Resources>
        <SolidColorBrush x:Key="SideA" Color="#4D9BFF"/>
        <SolidColorBrush x:Key="SideB" Color="#FFB347"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The title strip's minimize / close (ThemedChrome): flat, a light veil on hover. -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The main action: purple. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrand}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Brand}" BorderBrush="{DynamicResource Brush.BrandEdge}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BrandEdge}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A secondary action: dark, a thin frame. -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Button}" BorderBrush="{DynamicResource Brush.ButtonEdge}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameHover}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Frame}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.DangerSoft}"/>
        </Style>

        <!-- The four pages, as tabs: the chosen one underlined in purple. -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="16,8" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A choice among several (the test length): a pill, lit in purple when chosen. -->
        <Style x:Key="PresetChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.BodySoft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Button}" BorderBrush="{DynamicResource Brush.ButtonEdge}" BorderThickness="1" CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BrandSelect}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An on/off choice: the same pill. -->
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.BodySoft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Button}" BorderBrush="{DynamicResource Brush.ButtonEdge}" BorderThickness="1" CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BrandSelect}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The A and B boxes of a run: lit in the side's colour (its Tag) when ticked. -->
        <Style x:Key="SideChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Width="28" Height="24" Background="Transparent" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="Foreground" Value="#0B1016"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fields: dark, rounded, the frame purple while typing. -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Body}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Brand}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FrameHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A run in the list: a card, lit in purple with a bar on its left when chosen. -->
        <Style x:Key="RunItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.BodySoft}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,6,4">
                            <Border x:Name="Bd" Background="#0DFFFFFF" CornerRadius="8" Padding="12,9,12,9">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Mark" Width="3" CornerRadius="1.5" Background="{DynamicResource Brush.Brand}"
                                    HorizontalAlignment="Left" Margin="0,10" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BrandNav}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Dim}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs.11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs.11}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Frame}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource Color.SurfaceTop}" Offset="0"/>
                <GradientStop Color="{DynamicResource Color.SurfaceBottom}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <!-- A thin dark scroll bar, the thumb only (here rather than in Window.Resources, where
                 ThemedChrome puts the main window's own). -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.Thumb}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <DockPanel Margin="24,12,20,12">
            <!-- The title and the four pages. -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{local:Loc DummyTest.Heading}" FontSize="{DynamicResource Fs.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" Margin="2,0,0,2"/>
                <TextBlock Text="{local:Loc DummyTest.Intro}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="2,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabSetup" Style="{StaticResource TabButton}" GroupName="Tabs" Tag="Setup" Content="{local:Loc DummyTest.Tab.Setup}" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabRuns" Style="{StaticResource TabButton}" GroupName="Tabs" Tag="Runs" Content="{local:Loc DummyTest.Tab.Runs}" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabResults" Style="{StaticResource TabButton}" GroupName="Tabs" Tag="Results" Content="{local:Loc DummyTest.Tab.Results}" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabExport" Style="{StaticResource TabButton}" GroupName="Tabs" Tag="Export" Content="{local:Loc DummyTest.Tab.Export}" Checked="OnTabChecked"/>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Brush.Frame}" Margin="0,-1,0,0"/>
            </StackPanel>

            <!-- A short message at the foot (copied, saved, a refusal). -->
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{DynamicResource Brush.BrandText}" FontSize="{DynamicResource Fs.11.5}"
                       TextWrapping="Wrap" Margin="2,8,0,0" MinHeight="16"/>

            <Grid Margin="0,14,0,0">
                <!-- ================= Setup ================= -->
                <Grid x:Name="SetupPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{local:Loc DummyTest.Setup.Length}" Style="{StaticResource Caption}"/>
                            <WrapPanel x:Name="PresetPanel" Margin="0,0,0,10"/>

                            <TextBlock Text="{local:Loc DummyTest.Setup.Label}" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="LabelBox" MaxLength="60"/>
                            <TextBlock Text="{local:Loc DummyTest.Setup.Label.Hint}" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11}" TextWrapping="Wrap" Margin="2,4,0,12"/>

                            <TextBlock Text="{local:Loc DummyTest.Setup.Note}" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="NoteBox" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

                            <Button x:Name="RunButton" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" MinWidth="200" Click="OnRunClicked"/>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="StateText" FontSize="{DynamicResource Fs.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="StateDetail" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{local:Loc DummyTest.Setup.Overlay}" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="OverlayToggle" Style="{StaticResource PillToggle}" Content="{local:Loc DummyTest.Setup.Overlay.Show}" Click="OnOverlayToggled"/>
                                <ToggleButton x:Name="MoveToggle" Style="{StaticResource PillToggle}" Content="{local:Loc DummyTest.Setup.Overlay.Move}" Click="OnMoveToggled"
                                              ToolTip="{local:Loc DummyTest.Setup.Overlay.Move.Tip}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{local:Loc DummyTest.Check.Title}" FontSize="{DynamicResource Fs.15}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}"/>
                                <TextBlock Text="{local:Loc DummyTest.Check.Sub}" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11.5}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                <ItemsControl x:Name="CheckList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="{DynamicResource Fs.14}" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{DynamicResource Brush.Frame}" Margin="0,6,0,12"/>
                                <TextBlock Text="{local:Loc DummyTest.Skills.Title}" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="SkillsHintText" Foreground="{DynamicResource Brush.BrandText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="PrepareButton" Style="{StaticResource QuietButton}" Content="{local:Loc DummyTest.Skills.Prepare}" Margin="0,0,8,0" Click="OnPrepareClicked"
                                            ToolTip="{local:Loc DummyTest.Skills.Prepare.Tip}"/>
                                    <Button x:Name="ConfirmButton" Style="{StaticResource QuietButton}" Content="{local:Loc DummyTest.Skills.Read}" Click="OnConfirmClicked"
                                            ToolTip="{local:Loc DummyTest.Skills.Read.Tip}"/>
                                </WrapPanel>
                                <TextBlock Text="{local:Loc DummyTest.Skills.Why}" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Runs ================= -->
                <Grid x:Name="RunsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <!-- Which runs make A and which make B, and the way to the results. -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{local:Loc DummyTest.Runs.Hint}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="2,0,0,8"/>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource QuietButton}" Content="{local:Loc DummyTest.Runs.Clear}" Margin="0,0,8,0" Click="OnClearSidesClicked"/>
                                    <Button x:Name="CompareButton" Style="{StaticResource ActionButton}" Content="{local:Loc DummyTest.Runs.Compare}" MinHeight="30" Click="OnCompareClicked"/>
                                </StackPanel>
                                <TextBlock x:Name="SidesText" Foreground="{DynamicResource Brush.Heading}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,10,0"/>
                            </DockPanel>
                            <!-- Runs that share a name make one setup: one click puts them all in A or in B. -->
                            <StackPanel x:Name="LabelsBox" Margin="0,10,0,0">
                                <TextBlock Text="{local:Loc DummyTest.Runs.Setups}" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
                                <ItemsControl x:Name="LabelsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0DFFFFFF" CornerRadius="7" Padding="9,3,5,3" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Content="→ A" Style="{StaticResource QuietButton}" MinHeight="24" Padding="9,0" Margin="0,0,4,0" Click="OnLabelToA"
                                                            ToolTip="{local:Loc DummyTest.Runs.Setup.ToA}" Foreground="{StaticResource SideA}"/>
                                                    <Button Content="→ B" Style="{StaticResource QuietButton}" MinHeight="24" Padding="9,0" Click="OnLabelToB"
                                                            ToolTip="{local:Loc DummyTest.Runs.Setup.ToB}" Foreground="{StaticResource SideB}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <TextBlock x:Name="RunsEmpty" Text="{local:Loc DummyTest.Runs.Empty}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="8,12,0,0" Visibility="Collapsed"/>
                            <ListBox x:Name="RunsList" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource RunItem}"
                                     SelectionMode="Single" SelectionChanged="OnRunSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ToggleButton Style="{StaticResource SideChip}" Content="A" Tag="{StaticResource SideA}" IsChecked="{Binding IsA, Mode=TwoWay}" IsEnabled="{Binding CanCompare}"
                                                              ToolTip="{local:Loc DummyTest.Runs.PutA}"/>
                                                <ToggleButton Style="{StaticResource SideChip}" Content="B" Tag="{StaticResource SideB}" IsChecked="{Binding IsB, Mode=TwoWay}" IsEnabled="{Binding CanCompare}"
                                                              ToolTip="{local:Loc DummyTest.Runs.PutB}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="{DynamicResource Fs.11.5}" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Badges}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{Binding Brush}" BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="{DynamicResource Fs.10}" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Dps}" FontWeight="SemiBold" TextAlignment="Right"/>
                                                <TextBlock Text="DPS" FontSize="{DynamicResource Fs.10}" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>

                    <!-- The chosen run: its name and note can be changed, it can be deleted. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="DetailNone" Text="{local:Loc DummyTest.Detail.None}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
                            <StackPanel x:Name="DetailBox" Visibility="Collapsed">
                                <TextBlock x:Name="DetailTitle" FontSize="{DynamicResource Fs.15}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailFacts" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11.5}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <TextBlock Text="{local:Loc DummyTest.Setup.Label}" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="DetailLabel" MaxLength="60" Margin="0,0,0,10"/>
                                <TextBlock Text="{local:Loc DummyTest.Setup.Note}" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="DetailNote" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" Height="86" VerticalContentAlignment="Top" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource QuietButton}" Content="{local:Loc DummyTest.Detail.Save}" Margin="0,0,8,0" Click="OnSaveDetailClicked"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{local:Loc DummyTest.Detail.Delete}" Click="OnDeleteClicked"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= Results ================= -->
                <ScrollViewer x:Name="ResultsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="ResultsEmpty" Text="{local:Loc DummyTest.Results.Empty}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="2,4,0,12"/>

                        <StackPanel x:Name="ComparisonBox" Visibility="Collapsed">
                            <TextBlock x:Name="ResultsHeader" FontSize="{DynamicResource Fs.15}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                            <TextBlock x:Name="RefusalText" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="2,0,0,10" Visibility="Collapsed"/>

                            <StackPanel x:Name="ComparedBox">
                                <!-- The answer first: what the level change did, then the total DPS and whether it is more than noise. -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc DummyTest.Results.Verdict}" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="VerdictText" FontSize="{DynamicResource Fs.14}" Foreground="{DynamicResource Brush.BrandText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc DummyTest.Results.Dps}" Style="{StaticResource Caption}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="DpsHeadline" FontSize="{DynamicResource Fs.20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" VerticalAlignment="Center"/>
                                            <TextBlock Text="DPS" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DpsStatement" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{local:Loc DummyTest.Results.Skills}" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                                <!-- Column heads, on the same grid as the lines under them. -->
                                <Border Padding="6,0,6,6" BorderBrush="{DynamicResource Brush.Frame}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Loc DummyTest.Col.Skill}" Style="{StaticResource Head}" TextAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{local:Loc DummyTest.Col.Level}" Style="{StaticResource Head}"/>
                                        <TextBlock Grid.Column="2" Text="{local:Loc DummyTest.Col.Uses}" Style="{StaticResource Head}"/>
                                        <TextBlock Grid.Column="3" Text="{local:Loc DummyTest.Col.PlainA}" Style="{StaticResource Head}"/>
                                        <TextBlock Grid.Column="4" Text="{local:Loc DummyTest.Col.PlainB}" Style="{StaticResource Head}"/>
                                        <TextBlock Grid.Column="5" Text="{local:Loc DummyTest.Col.Change}" Style="{StaticResource Head}"/>
                                        <TextBlock Grid.Column="6" Text="{local:Loc DummyTest.Col.Crit}" Style="{StaticResource Head}"/>
                                        <TextBlock Grid.Column="7" Text="{local:Loc DummyTest.Col.Verdict}" Style="{StaticResource Head}" TextAlignment="Left" Margin="14,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="SkillRows" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBack}" Opacity="{Binding RowOpacity}" CornerRadius="6" Padding="6,5" Margin="0,0,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="170"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}" Style="{StaticResource Number}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Uses}" Style="{StaticResource Number}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PlainA}" Style="{StaticResource Number}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding PlainB}" Style="{StaticResource Number}"/>
                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Change}" Foreground="{Binding VerdictBrush}" Style="{StaticResource Number}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Interval}" Style="{StaticResource Number}" FontSize="{DynamicResource Fs.10}" Foreground="{DynamicResource Brush.Muted}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="6" Text="{Binding Crit}" Foreground="{Binding CritBrush}" Style="{StaticResource Number}" ToolTip="{Binding CritTip}"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" Margin="14,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{local:Loc DummyTest.Results.PlainNote}" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11}" FontStyle="Italic" TextWrapping="Wrap" Margin="2,6,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="WarningsBox" Margin="0,16,0,0">
                                <TextBlock Text="{local:Loc DummyTest.Results.Warnings}" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
                                <ItemsControl x:Name="WarningsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="!" Foreground="{DynamicResource Brush.Warning}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource Brush.WarningSoft}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Where the next point of improvement is, from every confirmed run of every setup. -->
                        <StackPanel Margin="0,22,0,10">
                            <TextBlock Text="{local:Loc DummyTest.Ranking.Title}" FontSize="{DynamicResource Fs.15}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Heading}" Margin="2,0,0,2"/>
                            <TextBlock Text="{local:Loc DummyTest.Ranking.Sub}" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11.5}" TextWrapping="Wrap" Margin="2,0,0,8"/>
                            <TextBlock x:Name="RankingEmpty" Text="{local:Loc DummyTest.Ranking.Empty}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="2,0,0,0"/>
                            <ItemsControl x:Name="RankingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0DFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                                                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Levels}" Foreground="{DynamicResource Brush.Label}" Style="{StaticResource Number}"/>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Gain}" FontWeight="SemiBold" Foreground="{Binding GainBrush}" Style="{StaticResource Number}"/>
                                                    <TextBlock Text="{Binding Relative}" FontSize="{DynamicResource Fs.10}" Foreground="{DynamicResource Brush.Muted}" Style="{StaticResource Number}"/>
                                                </StackPanel>
                                                <Border Grid.Column="5" BorderBrush="{Binding TierBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tier}" Foreground="{Binding TierBrush}" FontSize="{DynamicResource Fs.10}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Text="{Binding Note}" Foreground="{DynamicResource Brush.Muted}" FontSize="{DynamicResource Fs.11}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= Export ================= -->
                <DockPanel x:Name="ExportPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{local:Loc DummyTest.Export.Intro}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="2,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CopyButton" Style="{StaticResource ActionButton}" Content="{local:Loc DummyTest.Export.Copy}" Margin="0,0,8,0" Click="OnCopyClicked"/>
                            <Button x:Name="CsvButton" Style="{StaticResource QuietButton}" Content="{local:Loc DummyTest.Export.Csv}" Click="OnSaveCsvClicked"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="ExportEmpty" Text="{local:Loc DummyTest.Export.Empty}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="2,8,0,0"/>
                        <TextBox x:Name="ExportPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Cascadia Mono" FontSize="{DynamicResource Fs.12}"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
